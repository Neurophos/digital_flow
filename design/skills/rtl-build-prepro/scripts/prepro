import sys
import os
import re
import string

SM_Initial      = 0
SM_PreproLine   = SM_Initial      + 1
SM_PreproBegin  = SM_PreproLine   + 1
SM_PreproEnd    = SM_PreproBegin  + 1
SM_DotFile      = SM_PreproEnd    + 1
SM_Substitution = SM_DotFile      + 1
SM_SubstLeft    = SM_Substitution + 1
SM_SubstRight   = SM_SubstLeft    + 1
SM_Header       = SM_SubstRight   + 1
SM_Output       = SM_Header       + 1
SM_Arguments    = SM_Output       + 1

PAD_None        = 0
PAD_Left        = PAD_None + 1
PAD_Right       = PAD_Left + 1

class Preprocessor:
  def __init__(self):
    # Initialize variables

    self.d_infile        = '-'
    self.d_outfile       = '-'
    self.d_dotfile       = ''
    self.d_tab           = ''
    self.d_indent        = ''
    self.d_delete        = True
    self.d_headers       = []
    self.d_arguments     = ''
    self.d_substitutions = []
    self.default_python()
    # Original python 2 code: 
    # self.d_subst_meta    = re.compile('([\.\^\$\*\+\?\|\{\}\[\]\(\)\\\\])')
    # self.d_slash_quote   = re.compile(r'([\'\\])')
    # self.d_prepro_code   = re.compile('(\s*)[^#]*([^\s#])\s*#?.*')
    self.d_subst_meta    = re.compile('([.^$*+?|{}]()\\\\])')
    self.d_slash_quote   = re.compile(r'([\'])')
    self.d_prepro_code   = re.compile(r'(\s*)[^#]*([^\s#])\s*#?.*', re.ASCII)

    # State machine to parse command line arguments

    state = SM_Initial
    for arg in sys.argv[1:]:
      # print("Arg is: ", arg)
      if state == SM_Initial:
        if   arg == '-pl' or arg == '--perl':          self.default_perl()
        elif arg == '-py' or arg == '--python':        self.default_python()
        elif arg == '-c'  or arg == '--code':          state = SM_PreproLine
        elif arg == '-b'  or arg == '--begin':         state = SM_PreproBegin
        elif arg == '-e'  or arg == '--end':           state = SM_PreproEnd
        elif arg == '-f'  or arg == '--file':          state = SM_DotFile
        elif arg == '-r'  or arg == '--replace':       state = SM_Substitution
        elif arg == '-rl' or arg == '--replace-left':  state = SM_SubstLeft
        elif arg == '-rr' or arg == '--replace-right': state = SM_SubstRight
        elif arg == '-d'  or arg == '--define':        state = SM_Header
        elif arg == '-o'  or arg == '--output':        state = SM_Output
        elif arg == '++':                              state = SM_Arguments
        elif arg == '-k'  or arg == '--keep':          self.d_delete = False
        elif arg == '-h'  or arg == '--help':
          print("Usage: prepro [OPTION]... [FILE]")
          print("run Perl or Python preprocessor on a text file.\n")
          print("           FILE          Name of the input text file, standard input \"-\" by default.\n")
          print("  -o FILE, --output FILE Name of the output text file, standard output \"-\" by default.\n")
          print("  -d LINE, --define LINE Line of preprocessor code inserted before the preprocessor code")
          print("                         generated from the input. This option is typically used to define")
          print("                         preprocessor variables from the command line.\n")
          print("  -h,      --help        Print this usage information. Quit preprocessor.\n")
          print("  -pl,     --perl        Select the Perl preprocessor; set Perl defaults.\n")
          print("  -py,     --python      Select the Python preprocessor; set Python defaults.\n")
          print("  -f FILE, --file FILE   Name of intermediate file generated by prepro.")
          print("                         Default: .<output_file_name> or .prepro if the output is the")
          print("                         standard output \"-\"\n")
          print("  -k,      --keep        Do not delete the intermediate file.\n")
          print("  -c ID,   --code ID     Identifier for preprocessor code")
          print("                         Default usage for Perl:   // pl <perl code>")
          print("                         Default usage for Python: // py <python code>")
          print("                         Note that white-space before // is deleted.\n")
          print("  -b ID,   --begin ID    Identifier for beginning of multi-line preprocessor code")
          print("                         Default for Perl:   /* pl-begin")
          print("                         Default for Python: /* py-begin\n")
          print("  -e ID,   --end ID      Identifier for end of multi-line preprocessor code")
          print("                         Default for Perl:   pl-end */")
          print("                         Default for Python: py-end */\n") 
          print("  -r ID,   --replace ID  Text to be replaced with a preprocessor variable or expression.")
          print("                         Defaults: #$ and #[;]#")
          print("                         Occurrances of #$<variable> in the input will be replaced with")
          print("                         the value of the preprocessor variable in the output.")
          print("                         Occurrances of #$<variable>#text in the input will be replaced")
          print("                         with the value of the preprocessor variable in the output and the")
          print("                         delimiting # removed.")
          print("                         Occurrances of #[<expression>]# in the input will be replaced with")
          print("                         the value of the preprocessor expression in the output.")
          print("                         A semi-colon denotes an expression substitution and the location")
          print("                         of the expression.\n")
          print("  -rl ID,  --left ID     Identical to -r/--replace except the output text is padded with")
          print("                         trailing spaces to the width of the input text.")
          print("                         Default: #<;<#\n")
          print("  -rr ID,  --right ID    Identical to -r/--replace except the output text is padded with")
          print("                         leading spaces to the width of the input text.")
          print("                         Default: #>;>#\n")
          print(" ++ ARGS                 Command line arguments may be passed to the preprocessor script")
          print("                         using ++ followed by a list of arguments.")
          sys.exit()
        else: 
           # print("setting input file:",arg)
           self.d_infile = arg


      elif state == SM_PreproLine:
        self.d_prepro_line = arg
        state = SM_Initial

      elif state == SM_PreproBegin:
        self.d_prepro_begin = arg
        state = SM_Initial

      elif state == SM_PreproEnd:
        self.d_prepro_end = arg
        state = SM_Initial

      elif state == SM_DotFile:
        self.d_dotfile = arg
        state = SM_Initial

      elif state == SM_Substitution:
        self.d_substitutions.append((arg, PAD_None))
        state = SM_Initial

      elif state == SM_SubstLeft:
        self.d_substitutions.append((arg, PAD_Left))
        state = SM_Initial

      elif state == SM_SubstRight:
        self.d_substitutions.append((arg, PAD_Right))
        state = SM_Initial

      elif state == SM_Header:
        self.d_headers.append(arg)
        state = SM_Initial

      elif state == SM_Output:
        # print("Setting outut file: ",arg)
        self.d_outfile = arg
        state = SM_Initial

      elif state == SM_Arguments:
        self.d_arguments = self.d_arguments+' '+arg
        # print("Python Args are:",self.d_arguments)

    # Use default substitutions of user provided none

    if self.d_substitutions == []:
      self.d_substitutions.append(('#<;<#', PAD_Left))
      self.d_substitutions.append(('#>;>#', PAD_Right))
      self.d_substitutions.append(('#[;]#', PAD_None))
      self.d_substitutions.append(('#$', PAD_None))

  # Default parameters for Perl

  def default_perl(self):
    self.d_language     = 'perl'
    self.d_prepro_line  = '// pl'
    self.d_prepro_begin = '/* pl-begin'
    self.d_prepro_end   = 'pl-end */'
    self.d_block_start  = '{'
    self.d_exp_start    = '.('
    self.d_exp_end      = ').'
    self.d_var_start    = '.$'
    self.d_var_end      = '.'
    self.d_eol          = '\'.\"\\n\".\''

  # Default parameters for Python

  def default_python(self):
    self.d_language     = 'python3'
    self.d_prepro_line  = '// py '
    self.d_prepro_begin = '/\\* py-begin'
    self.d_prepro_end   = 'py-end \\*/'
    self.d_block_start  = ':'
    self.d_exp_start    = '+str('
    self.d_exp_end      = ')+'
    self.d_var_start    = '+str('
    self.d_var_end      = ')+'
    self.d_eol          = ''

  # Place back-slash before meta-characters

  def subst_meta(self, string):
    return self.d_subst_meta.sub(r'\\\1', string)

  # Place back-slash before back-slash and quote characters

  def slash_quote(self, string):
    return self.d_slash_quote.sub(r'\\\1', string)

  # Update current indent of output script

  def calc_indent(self, line):
    match = self.d_prepro_code.match(line)

    if match:
      if match.group(1): 
        mg1 = 'Y:<'+ match.group(1) + '>'
      else: 
        mg1 = 'N'
      if match.group(2): 
        mg2 = 'Y:<'+ match.group(2) + '>'
      else: 
        mg2 = 'N'

      # print("calc_indent: ", line, "g1:", mg1, "g2:", mg2 )
      self.d_indent = match.group(1)
      if match.group(2) == self.d_block_start:
        if self.d_tab == '': self.d_tab = self.d_indent
        if self.d_tab == '': self.d_indent = '  '
        else: self.d_indent = self.d_indent+self.d_tab
    else:
      self.d_indent = ''

  # Open input file or stream

  def open_input(self):
    # print("Input file: ",self.d_infile) 
    if self.d_infile == '-':
      # print("Reading stdin")
      self.d_input = sys.stdin
    else:
      try:
        self.d_input = open(self.d_infile,'r')
      except IOError:
        sys.stderr.write("Unable to open file: "+self.d_infile+"\n")
        sys.exit()

  # Open output script file

  def open_output(self):
    if self.d_dotfile == '':
      if self.d_outfile == '-':
        self.d_dotfile = '.prepro'
      else:
        self.d_dotfile = '.'+self.d_outfile
    os.system('/usr/bin/env rm -f '+self.d_dotfile)
    self.d_output = open(self.d_dotfile, 'w')

    if self.d_language == 'perl':
      self.d_output.write('sub prepro_pad {\n')
      self.d_output.write('  my $string = shift;\n')
      self.d_output.write('  my $target = shift;\n\n')
      self.d_output.write('  if ($target < 0) {\n')
      self.d_output.write('    while (length($string) < -$target) {\n')
      self.d_output.write('      $string = " $string";\n')
      self.d_output.write('    }\n')
      self.d_output.write('  } else {\n')
      self.d_output.write('    while (length($string) < $target) {\n')
      self.d_output.write('      $string = "$string ";\n')
      self.d_output.write('    }\n')
      self.d_output.write('  }\n')
      self.d_output.write('  return $string;\n')
      self.d_output.write('}\n')

    if self.d_language == 'python3':
      self.d_output.write('def prepro_pad (text, target):\n')
      self.d_output.write('  if target < 0:\n')
      self.d_output.write('    while len(text) < -target:\n')
      self.d_output.write('      text = " "+text\n')
      self.d_output.write('  else:\n')
      self.d_output.write('    while len(text) < target:\n')
      self.d_output.write('      text = text+" "\n')
      self.d_output.write('  return text\n\n')
      
    for line in self.d_headers:
      self.d_output.write(line+'\n')

  # Process the input file and write output script

  def process(self):
    # Prepare to recognise preprocessor lines
    
    prepro_line   = re.compile('\\s*'+self.subst_meta(self.d_prepro_line) +'(.*)')
    prepro_empty  = re.compile(self.subst_meta(self.d_prepro_line) +'$')
    prepro_begin  = re.compile('\\s*'+self.subst_meta(self.d_prepro_begin) + '(.*)')
    prepro_end    = re.compile('\\s*'+self.subst_meta(self.d_prepro_end)  +'(.*)')

    # Prepare to recognise variable and expression substitutions

    subst_code = []
    subst_vars = []
    for substitution in self.d_substitutions:
      subst = self.subst_meta(substitution[0])
      if -1 != subst.find(';'):
        subst_code.append((re.compile(subst.replace(';','(.*?)')), substitution[1]))
      else:
        subst_vars.append((re.compile(subst+'(\\w+)('+subst[0]+'?)'), substitution[1]))

    # Read and process each line in input file

    code = False
    for line in self.d_input.readlines():
      # print("input line: ", line)
      # if (prepro_begin.match(line)): 
      #   print("Matches prepro_begin") 
      # if(prepro_empty.match(line)): 
      #   print("Matches prepro_empty") 
      # if(prepro_line.match(line)): 
      #   print("Matches prepro_line") 
      # if(prepro_end.match(line)): 
      #   print("Matches prepro_end") 
      # If the line is not inside a chunk of preprocessor code

      if code == False:
        # If this line begins a chunk of preprocessor code

        if prepro_begin.match(line):
          code = True

        else:
          # If this line is empty

          if prepro_empty.match(line):
            self.d_indent = ''
          else:
            # If this is a preprocessor line

            match = prepro_line.match(line)
            if match:
              # Write code to output and update indent

              self.d_output.write(match.group(1)+line[-1])
              self.calc_indent(match.group(1))
            else:
              # Split line if it contains substitutions

              line = self.subst_line(subst_code, self.d_exp_start, self.d_exp_end, [line[:-1]])
              line = self.subst_line(subst_vars, self.d_var_start, self.d_var_end, line)

              # Protect back-slash and quote

              index = 0
              while index < len(line):
                if (index & 1) == 0:
                  line[index] = self.slash_quote(line[index])
                index += 1

              # Write to output script file

              # Original code: 
              # self.d_output.write(self.d_indent+'print \''+string.join(line, '')+self.d_eol+'\';\n')
              line_string = ''.join(str(item) for item in line)
              # print("line_string: ", line_string)
              output_str = str(self.d_indent) + "print('" + line_string + str(self.d_eol) + "')"
              # self.d_output.write(str(self.d_indent) + "print(\" + line_string + str(self.d_eol) + '\';\n')
              self.d_output.write(output_str)
              self.d_output.write("\n")

      # Else if end of chunk of preprocessor code

      elif prepro_end.match(line):
        code = False

      else:
        # Write to output and update indent

        self.d_output.write(line)
        self.calc_indent(line[:-1])

    # Close the input file/stream and the output script file

    self.d_input.close()
    self.d_output.close()

  # Perform variable/expression substitutions on array of line chunks

  def subst_line(self, substitutions, start, end, line):
    # For all substitutions

    for substitution in substitutions:

      # For all line segments

      index = 0
      while index < len(line):
        # If an unsubtituted segments

        if (index & 1) == 0:
          # If the segment contains a substitution

          match = substitution[0].search(line[index])
          if match:
            # Replace the segment with three new segments:
            # the segment before the substitution, the substitution,
            # and the segment after the substitution

            span = match.span()
            swap = match.group(1)
            if substitution[1] == PAD_Left:
              swap = 'prepro_pad('+swap+', '+str(len(match.group(0)))+')'
            if substitution[1] == PAD_Right:
              swap = 'prepro_pad('+swap+', -'+str(len(match.group(0)))+')'
            line[index:index+1] = [
              line[index][:span[0]],
              '\''+start+swap+end+'\'',
              line[index][span[1]:]]
        index += 1

    # Return the line segments

    return line

  # Run the output script

  def execute(self):
    command = '/usr/bin/env '+self.d_language+' '+self.d_dotfile+self.d_arguments
    if self.d_outfile != '-':
      command = command+' > '+self.d_outfile
    if 0 == os.system(command) and self.d_delete:
      os.system('/usr/bin/env rm -f '+self.d_dotfile)

  # Run the preprocessor

  def run(self):
    self.open_input()
    self.open_output()
    self.process()
    self.execute()

# Build and run the preprocessor
 
preprocessor = Preprocessor()
preprocessor.run()
