sub output_lef {
    my ($fh, $cfg) = @_;

    my ($top, $container) = chk_top($cfg);
    my @lib               = chk_libs($cfg);

    my %arg = (
        cfg       => $cfg, 
        descend   => [qw/submodules/], 
        collect   => { lef => [qw/ lef /], },
        out       => (my $out_ref = {}),
    );

    process_hier( %arg, container => "libraries", name => $_   ) foreach @lib;
    process_hier( %arg, container => "modules",   name => $top );

    my $missed_ref = {};

    print $fh "$_\n" foreach output_paths( $fh, $missed_ref, @{$cfg->{libraries}{$lib[0]}{tlef}} ); 

    print $fh "$_\n" foreach output_paths( $fh, $missed_ref, @{$out_ref->{lef}} );

    output_missed($fh, "#", $missed_ref);

    return scalar keys %$missed_ref;
}
