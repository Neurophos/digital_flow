    libdir_abs_sim_only => { type => "dir",    ref => "ARRAY",   group => "Data",  deprecated => "use libdir_sim_only"    },
    libdir_abs_syn_only => { type => "dir",    ref => "ARRAY",   group => "Data",  deprecated => "use libdir_syn_only"    },
