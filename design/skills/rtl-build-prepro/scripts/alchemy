                                                                                       rtl => "rtl/*_reg_top.sv", 
                                                                                       rtl => "rtl/*_apb_adapter_reg.sv",
                                                                                  packages => "rtl/*_reg_pkg.sv", ]       },
    packages            => { type => "file",   ref => "ARRAY",   group => "Data",                                         },
    packages_abs        => { type => "file",   ref => "ARRAY",   group => "Data",  deprecated => "use packages"           },
    interfaces          => { type => "file",   ref => "ARRAY",   group => "Data",                                         }, 
    interfaces_abs      => { type => "file",   ref => "ARRAY",   group => "Data",  deprecated => "use interfaces"         }, 
  },
