    libraries           => { type => "string", ref => "SCHEMA",  group => "TECH", },
    rc_corners          => { type => "string", ref => "SCHEMA",  group => "TECH", },
    timing_conditions   => { type => "string", ref => "ARRAY",   group => "TECH", },
    delay_corners       => { type => "string", ref => "SCHEMA",  group => "TECH", },
  },                                           
                                               
  modules => {                                 
    yaml                => { type => "file",                                       need => "opt",                        
