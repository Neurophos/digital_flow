    rtl_abs_sim_only    => { type => "file",   ref => "ARRAY",   group => "Data", unique => 1, deprecated => "use rtl_sim_only"       },
    rtl_abs_syn_only    => { type => "file",   ref => "ARRAY",   group => "Data", unique => 1, deprecated => "use rtl_syn_only"       },
    libdir              => { type => "dir",    ref => "ARRAY",   group => "Data",                                         },
