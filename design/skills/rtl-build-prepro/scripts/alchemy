my %Modes = ( # yaml_type 
   dump =>  { design => 1, tb => 1, tech => 1 },
   sim  =>  { design => 1, tb => 1, tech => 0 },
   regs =>  { design => 1, tb => 1, tech => 0 },
   syn  =>  { design => 1, tb => 0, tech => 0 },
   lef  =>  { design => 1, tb => 0, tech => 0 },
   gds  =>  { design => 1, tb => 0, tech => 0 },
   cdl  =>  { design => 1, tb => 0, tech => 0 },
   mmmc =>  { design => 1, tb => 0, tech => 0 },
);

# ---------------------------------------------------------------------------- #
sub usage {
    my $err = shift;
    print <<EOH;
================================================================================
\$ alchemy [switches]                        (A-HiErarchical-Manifest/YAML tool)

Input Files                                        (>=1 required; read in order)
+------------------------------------------------------------------------------+
| (-yaml <file>)...  Top-level YAML(s) to process                              |
+------------------------------------------------------------------------------+

Options
+------------------------------------------------------------------------------+
| -top  <name>       Set top entity  (default: top_module|default_tb from YAML)|
| -lib  <name>       Set cell library             (default: use_libs from YAML)|
|                      (may be space-separated string; first sets tlef)        |
| -ws   <dir>        Use <dir> for path detection               (default: \$PWD)|
| -var  <var>        Prefix "\$<var>/" for rel paths in output     (default: WS)| 
|                      (auto-sets to "" (no-prefix) for any STDOUT output)     |
+------------------------------------------------------------------------------+

Output generation                    (>=1 required; any 1 may be "-" for STDOUT)
+------------------------------------------------------------------------------+
| -sim  <sim.f>      Simulation RTL manifest (+ *_sim_only*, - *_syn_only)     |
| -syn  <syn.f>      Synthesis RTL manifest  (+ *_syn_only*, - *_sim_only)     |
| -mmmc <mmmc.tcl>   Cadence Stylus Multi-Mode-Multi-Corner Tcl                |
| -lef  <lef.f>      LEF manifest (first entry is .tlef (technology-LEF))      |
| -gds  <gds.f>      GDS manifest                                              |
| -cdl  <cdl.f>      CDL manifest                                              |
| -regs <dirs.f>     Dirs in which to run regtool (via 'make'; see example)    |
| -dump <out.pl>     Perl dump of all YAML data (-top ignored)                 |
+------------------------------------------------------------------------------+

Behavior flags
+------------------------------------------------------------------------------+
| -check             Parse, validate YAML(s), exit (ignore output selection(s))|
| -quiet             Suppress INFO and WARNING (but still ERROR if needed)     |
| -keep              Output any MISSING paths as normal        (default: abort)|
| -drop              Remove any MISSING paths from output      (default: abort)|
| -abs               Output all absolute paths (default: use "\$<var>/" prefix) |
+------------------------------------------------------------------------------+

examples:
\$ alchemy -yaml design/chip_top/config/chip_top.yaml -check
\$ alchemy -yaml config/block.yaml -top block -rtl run.f
\$ alchemy -yaml design/core/config/core.yaml -syn genus.f 
\$ alchemy -yaml zz.yaml -quiet -regs - | while read d ; do make -C \$d ; done
\$ alchemy -yaml \$IP_DIR/config/foo.yaml -syn syn.f -lef lef.f -mmmc mmmc.tcl
================================================================================

EOH
    die "ERROR: $err\n" if $err;
    exit;
}
# ---------------------------------------------------------------------------- #
# YAML Schema Schema / Field Attributes
#
# type     => <type>              : required: enum|string|file|dir|find
#   values => <name(s)>           : for type=enum, list of valid values
#   unique => 1|0                 : for type=file, warn if not unique leafname
#   glob   => [                   : for type=dir, pairs of fields and
#      (<field> => <pat>)...          glob patterns to fill with
#   ]
#   search  => [                  : for type=find, if not a file (but is a dir),
#      <suffix>...                     a list of paths to try to find a file
#   ]                                  If no match, immediately fatal (because
#                                      used for sub-YAML detection)
#
# ref      => <REFTYPE>           : SCHEMA  = <field> is a new schema level
#                                   HASH    = <field> is a  hash  of string|file|dir
#                                   HASHARR = <field> is a  hash  of 
#                                                        an array of string|file|dir
#                                   ARRAY   = <field> is an array of string|file|dir
#
# need     => opt|req             : required for all fields (or, if group, 
#                                      must set on at least 1 member) 
#   if     => <condition>         :   modify <need> of field/group
#
#                                     ["eq",  "<field>", "<value>"]
#                                     ["ne",  "<field>", "<value>"]
#                                     ["set", "<field|group>"]
#                                     ["not", "<field|group>"]
#
# group    => <group-name>        : mark field as belonging to a group
#   count  => N|all|any           : for group, configure behaviour
#                                     (must set on at least 1 member)
#                                      
#                                                         need
#                                                       req  opt
#                                     all : all members must may be set
#                                     any : any members must may be set
#                                     <N> : <N> members must may be set
# 
# deprecated => <message>           : if used, warn with <message>
# ---------------------------------------------------------------------------- #

my $Y_Schema = {
      
  FILE => {
    # universal
    yaml                => { type => "find",   ref => "ARRAY",                     need => "opt", 
        search => [ # additive, so later matches add new fields OR override previous fields
            "%DIR/config/%BASE.yaml",                           # base IP yaml
            "utils/proj_utils/blocks/%BASE/config/%BASE.yaml",  # PD add-ons (ie, constraints:)
            "utils/impl_utils/config/ext/%BASE.yaml",           # central yaml for 99% of external-IP
            "utils/proj_utils/config/ext/%BASE.yaml",           # proj-specific yaml for 1% of external-IP
        ] 
    },
                                                                                   
    yaml_type           => { type => "enum",   values => [qw/design tech tb/],     need => "req", },
                                               
    # design                                                     
    top_module          => { type => "string",                   group => "DReq",  need => "req",  count => "all", if => [qw/eq yaml_type design/],},
    modules             => { type => "string", ref => "SCHEMA",  group => "DReq", },
                                                                 
    common              => { type => "string", ref => "SCHEMA",  group => "DOpt",  need => "opt",  count => "any", if => [qw/eq yaml_type design/],
                                                                                   deprecated => "use hier yaml"},

    ### Even this this is decrepated, removing it breaks the Schema check. The check looks
    ### for at least 2 or more fields with a group of type DOpt. Without this, there is only
    ### 1 field of that type, and the check fails. Could perhaps update the check...
    defines_syn         => { type => "string", ref => "ARRAY",   group => "DOpt", }, # TODO: deprecate

    # tb                                                         
    default_tb          => { type => "string",                   group => "TB",    need => "req",  count => "all", if => [qw/eq yaml_type tb/    ],},
    testbenches         => { type => "string", ref => "SCHEMA",  group => "TB",   },
                                                                 
    # tech                                                       
