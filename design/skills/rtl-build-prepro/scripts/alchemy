sub output_mmmc {
    my ($fh, $cfg) = @_;

    # check before processing:
    my ($top, $container) = chk_top($cfg);
    my @lib               = chk_libs($cfg);

    my %arg = (
        cfg       => $cfg, 
        descend   => [qw/submodules/], 
        collect   => { lib => [qw/ lib /], sdc => [qw/ sdc /]},
        out       => (my $out_ref = {}),
    );

    process_hier( %arg, container => "libraries", name => $_   ) foreach @lib;
    process_hier( %arg, container => "modules",   name => $top );

    # check after processing:
    my $modes = chk_constraints($cfg);

#print Dumper($out_ref), "\n";
#exit;

    my $missed_ref = {};

    print $fh "set temp [expr { [get_db program_short_name] eq \"genus\" ? \"temperature\" : \"T\"}]\n";
    print $fh "set $Ins{var} \$env($Ins{var})\n";

    for my $corner (sort keys %{$cfg->{tech}{rc_corners}}) {
        my  $ref  = $cfg->{tech}{rc_corners}{$corner};
        my ($qrc) = output_paths($fh, $missed_ref, $ref->{qrc_tech_file});
        print $fh "create_rc_corner -name rc_$corner -\$temp $ref->{temperature} -qrc_tech $qrc\n";
    }

    print $fh "\n";

    for my $tcon (sort @{$cfg->{tech}{timing_conditions}}) {
        print $fh "set libs {} ; # $tcon\n";
        print $fh "lap libs $_\n" foreach output_paths( $fh, $missed_ref, @{$out_ref->{lib}{$tcon}} );
        print $fh "create_library_set -name ls_$tcon -timing \$libs ; # -socv <list>\n";
        print $fh "\n";
    }

    print $fh "\n";

    for my $tcon (sort @{$cfg->{tech}{timing_conditions}}) {
        print $fh "create_timing_condition -name tc_$tcon -library_sets { ls_$tcon }\n";
    }

    print $fh "\n";

    for my $dc (sort keys %{$cfg->{tech}{delay_corners}}) {
        my $ref =           $cfg->{tech}{delay_corners}{$dc};
        print $fh "create_delay_corner -name dc_$dc -rc_corner rc_$ref->{rc_corner} -timing_condition tc_$ref->{timing_condition}\n";
    }

    print $fh "\n";

    output_missed($fh, "#", $missed_ref);

    return scalar keys %$missed_ref;
}
# ---------------------------------------------------------------------------- #
sub output_sim {
    my ($fh, $cfg) = @_;

    my ($top, $cont) = chk_top($cfg);

    process_hier(
        cfg       => $cfg,
        container => $cont, 
        name      => $top, 
        descend   => [qw/submodules_sim_only submodules/], 
        collect   => { 
            defines    => [qw/ defines_sim /],
            incdirs    => [qw/ incdir     incdir_abs    incdir_sim_only  incdir_abs_sim_only /],
            libdirs    => [qw/ libdir     libdir_abs    libdir_sim_only  libdir_abs_sim_only /],
            rtl_files  => [qw/ rtl        rtl_abs       rtl_sim_only     rtl_abs_sim_only    /],
            packages   => [qw/ packages   packages_abs   /],
            interfaces => [qw/ interfaces interfaces_abs /],
        },
        out     => (my $out_ref = {}),
    );

    print $fh "// Simulation RTL Manifest for: $top\n";

    return output_optionfile($fh, $out_ref);
}
# ---------------------------------------------------------------------------- #
sub output_syn {
    my ($fh, $cfg) = @_;

    my ($top, $cont) = chk_top($cfg);

    process_hier(
        cfg       => $cfg,
        container => "modules", 
        name      => $top, 
        descend   => [qw/submodules/], 
        collect   => { 
            defines    => [qw/ defines_syn /],
            incdirs    => [qw/ incdir     incdir_abs    incdir_syn_only  incdir_abs_syn_only /],
            libdirs    => [qw/ libdir     libdir_abs    libdir_syn_only  libdir_abs_syn_only /],
            rtl_files  => [qw/ rtl        rtl_abs       rtl_syn_only     rtl_abs_syn_only    /],
            packages   => [qw/ packages   packages_abs   /],
            interfaces => [qw/ interfaces interfaces_abs /],
        },
        out     => (my $out_ref = {}),
    );

    print $fh "// Synthesis RTL Manifest for: $top\n";

    return output_optionfile($fh, $out_ref);
}
# ---------------------------------------------------------------------------- #
sub output_optionfile {
    my ($fh, $out_ref) = @_;

    my $missed_ref = {};

    print $fh "\n// Library extensions: suffixes to match in Library directories\n\n";
    print $fh "+libext+.v+.sv+.vp+.vlib+\n";

    print $fh "\n// Global defines (defines_*)\n\n";
    print $fh "+define+$_\n" foreach uniq @{$out_ref->{defines}};

    print $fh "\n// Include directories (incdir*) to auto-search for \"`include <file>\"\n\n"; 
    print $fh "+incdir+$_\n" foreach output_paths( $fh, $missed_ref, @{$out_ref->{incdirs}} );

    print $fh "\n// Library directories (libdir*) to auto-search for \"<module>.<libext>\"\n\n"; 
    print $fh "-y $_\n"      foreach output_paths( $fh, $missed_ref, @{$out_ref->{libdirs}} );

    print $fh "\n// Package definition files (packages*)\n\n"; 
    print $fh "$_\n"         foreach output_paths( $fh, $missed_ref, @{$out_ref->{packages}} );

    print $fh "\n// Interface files (interfaces*)\n\n"; 
    print $fh "$_\n"         foreach output_paths( $fh, $missed_ref, @{$out_ref->{interfaces}} );

    print $fh "\n// RTL files (rtl*)\n\n"; 
    print $fh "$_\n"         foreach output_paths( $fh, $missed_ref, @{$out_ref->{rtl_files}} );

    output_missed($fh, "//", $missed_ref);

    return scalar keys %$missed_ref;
}
# ---------------------------------------------------------------------------- #
sub output_missed {
    my ($fh, $pfx, $missed_ref) = @_;

    if (%$missed_ref) {

        my $msg;
        if    ($Flags{keep}) { $msg = "but allowed and KEPT in output (-keep)"      } 
        elsif ($Flags{drop}) { $msg = "but allowed and DROPPED from output (-drop)" } 
        else                 { $msg = "(fatal ERROR)"                               }

        if (fileno($fh) == 1) {
            if (!$Flags{quiet}) {
            print STDERR "\n$pfx Referenced path(s) MISSING $msg\n";
            print STDERR "$pfx - $_\n" foreach sort keys %$missed_ref;
            }
        } else {
            print $fh   "\n$pfx Referenced path(s) MISSING $msg\n";
            print $fh   "$pfx - $_\n" foreach sort keys %$missed_ref;
        }
    }
}
# ---------------------------------------------------------------------------- #
sub output_paths { 
    my ($fh, $missed_ref, @in) = @_;

    my $fnum = fileno($fh); # auto-suppress prefix for STDOUT (1)
    my @out;

    for my $path (uniq @in) { 
        if ($Missing{$path}) { 
            $missed_ref->{$path} = 1;
            next if $Flags{drop};
        }
        if ($path !~ m{^/}) {
            if ($Flags{abs}) {
                $path = "$Ins{ws}/$path";
            } elsif ($Ins{var} ne "" && $fnum != 1) {
                $path = "\$$Ins{var}/$path";
            }
        }

        push @out, $path;
    } 

    return @out;
}
