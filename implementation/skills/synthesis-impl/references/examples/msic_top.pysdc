            print(f"    {p} \\")
        print(f"    }} ] [get_ports -group {g}]")

# Iterate through all the pins, and create a clock if the clk_freq is defined. Append the clkname to the list 'clks'  
clks = []
output_clks = {}

for p in pinlist.pins:
    if p.clk_freq != "":
        # For output clocks, define a virtual clock name with _vclk instead of _clk and use this for the output timing. 
        if (p.dir == "O"):
            # substitute _vclk for _clk in the signal name to generate the clock name. 
            vclk_name = p.core_nonpio_name.replace("_clk", "_vclk") 
            clk_name = p.core_nonpio_name
            clks.append(vclk_name)
            clks.append(clk_name)
