# ####################################################################################################
# SDC constraints for MSIC_TOP to be pre-processed by prepro before use. 
#
# The embedded python in this file will read the msic_pin_list.ods file which is used as the golden ref
#   for all the pins, and I/O level coonstraints.  
# From this spreadsheet, the python will do the following: 
# - Groups are made of the signals based on the 'group' column in the spreadsheet. 
# - Clocks are created if there is an entry within the 
#   and input and output constraints. 
# ####################################################################################################


/* py-begin

import sys, string, yaml, os
import soc_pylib.read_sysinfo as rsi
import soc_pylib.read_pinout as rpo
info = rsi.MsicSysInfo()
rsi.read_sysinfo(info)
digital_groups = ["DIGIO", "DIG_BOOTMODE", "DIG_POR", "DIG_CLK", "DIG_FABIO_T2C_SIGNAL", "DIG_FABIO_T2C_CLK",\
                    "DIG_FABIO_C2T_SIGNAL", "DIG_FABIO_C2T_CLK", "DIG_QSPI_SIGNAL", "DIG_QSPI_CLK", "DIG_JTAG_CLK",\
                    "DIG_JTAG_SIGNAL", "DIG_GPIO", "DIG_UART_SIGNAL" ] 

# Read the pin spreadsheet
pinlist = rpo.MsicPinList()
rpo.read_pin_list(pinlist)
